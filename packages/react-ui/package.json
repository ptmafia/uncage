{
  "name": "@uncage/react-ui",
  "version": "0.3.1",
  "description": "Default Uncage chat UI for React",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uncage/protocol": "workspace:^",
    "lucide-react": "^1.70.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@uncage/react": "workspace:^",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uncage/client": "workspace:*",
    "@uncage/react": "workspace:*",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/react-ui"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "react",
    "ui",
    "chat"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang",
  "homepage": "https://uncage-dev.vercel.app/docs/",
  "bugs": {
    "url": "https://github.com/ptmafia/uncage/issues"
  }
}
