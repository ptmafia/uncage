{
  "name": "@uncage/react",
  "version": "0.2.0",
  "description": "Headless React bindings for Uncage: normalized store, event reducer and hooks",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uncage/client": "workspace:^",
    "@uncage/protocol": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/react"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "react",
    "hooks"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang",
  "homepage": "https://uncage-dev.vercel.app/docs/",
  "bugs": {
    "url": "https://github.com/ptmafia/uncage/issues"
  }
}
