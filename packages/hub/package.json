{
  "name": "@uncage/hub",
  "version": "0.2.0",
  "description": "Uncage hub: device login, machine connections and the browser API for Connected Mode, mounted in your website's Node backend",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@uncage/core": "workspace:^",
    "@uncage/protocol": "workspace:^",
    "@uncage/server": "workspace:^",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ioredis": ">=5",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ioredis-mock": "^8.2.8",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "pg": "^8.23.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/hub"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "hub",
    "websocket",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang",
  "homepage": "https://uncage.vercel.app/docs/",
  "bugs": {
    "url": "https://github.com/ptmafia/uncage/issues"
  }
}
