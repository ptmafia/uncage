{
  "name": "@uncage/runtime-claude",
  "version": "0.0.0",
  "description": "Uncage runtime adapter for Claude Code via the Claude Agent SDK",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "tsup && node scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@uncage/protocol": "workspace:*"
  },
  "devDependencies": {
    "@uncage/testkit": "workspace:*"
  }
}
