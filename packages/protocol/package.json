{
  "name": "@uncage/protocol",
  "version": "0.1.0",
  "description": "Uncage wire protocol: types and Zod schemas",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "protocol",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang"
}
