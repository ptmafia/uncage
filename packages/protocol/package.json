{
  "name": "@uncage/protocol",
  "version": "0.2.0",
  "description": "Uncage wire protocol: types and Zod schemas",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/protocol"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "protocol",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang",
  "homepage": "https://ptmafia.github.io/uncage/",
  "bugs": {
    "url": "https://github.com/ptmafia/uncage/issues"
  }
}
