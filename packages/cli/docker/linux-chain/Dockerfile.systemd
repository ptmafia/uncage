# The Linux full chain, part 2: a systemd-booted Debian with a normal user `u`. The CLI comes from
# the local tarballs (Node 22 copied from the official image); the test drives it with docker exec:
# enable-linger, `uncage agent install`, the unit active, restarted after kill -9, and doctor
# flagging a pinned Node that was removed. Run with --privileged --cgroupns=host and /sys/fs/cgroup.
FROM node:22-bookworm-slim AS node

FROM debian:bookworm
ENV container=docker
RUN apt-get update \
  && apt-get install -y --no-install-recommends systemd systemd-sysv dbus dbus-user-session ca-certificates procps \
  && rm -rf /var/lib/apt/lists/* \
  && useradd -m -s /bin/bash u \
  # No getty / udev noise in a container.
  && systemctl mask getty@tty1.service systemd-udevd.service systemd-udevd-kernel.socket systemd-udevd-control.socket
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY pkgs/ /pkgs/
RUN npm install -g --no-audit --no-fund /pkgs/uncage-cli.tgz \
  # A second, user-owned copy of Node: the service is pinned to it, then it is removed.
  && mkdir -p /home/u/node22/bin && cp /usr/local/bin/node /home/u/node22/bin/node && chown -R u:u /home/u/node22
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
