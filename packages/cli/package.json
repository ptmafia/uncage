{
  "name": "@uncage/cli",
  "version": "0.2.0",
  "description": "The `uncage` command: serve the local daemon, run doctor, export events, and connect this computer to websites (Connected Mode)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "uncage": "./dist/bin.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uncage/agent": "workspace:^",
    "@uncage/core": "workspace:^",
    "@uncage/protocol": "workspace:^",
    "@uncage/runtime-claude": "workspace:^",
    "@uncage/runtime-codex": "workspace:^",
    "@uncage/server": "workspace:^",
    "pino": "^10.4.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@uncage/hub": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang",
  "homepage": "https://uncage.vercel.app/docs/",
  "bugs": {
    "url": "https://github.com/ptmafia/uncage/issues"
  }
}
