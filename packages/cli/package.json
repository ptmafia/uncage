{
  "name": "@uncage/cli",
  "version": "0.1.1",
  "description": "The `uncage` command: serve the local daemon, run doctor, export events",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "uncage": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uncage/core": "workspace:^",
    "@uncage/protocol": "workspace:^",
    "@uncage/runtime-claude": "workspace:^",
    "@uncage/runtime-codex": "workspace:^",
    "@uncage/server": "workspace:^",
    "pino": "^10.4.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang"
}
