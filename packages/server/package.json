{
  "name": "@uncage/server",
  "version": "0.2.0",
  "description": "Uncage local daemon: REST + SSE over @uncage/core, and a same-origin proxy for Next.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uncage/core": "workspace:^",
    "@uncage/protocol": "workspace:^",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@uncage/testkit": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/server"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "server",
    "sse",
    "proxy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang",
  "homepage": "https://uncage-dev.vercel.app/docs/",
  "bugs": {
    "url": "https://github.com/ptmafia/uncage/issues"
  }
}
