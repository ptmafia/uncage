{
  "name": "@uncage/runtime-codex",
  "version": "0.3.1",
  "description": "Uncage runtime adapter for Codex via the Codex App Server (stdio JSON-RPC)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uncage/protocol": "workspace:^"
  },
  "devDependencies": {
    "@uncage/testkit": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/runtime-codex"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "codex",
    "openai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang",
  "homepage": "https://uncage-dev.vercel.app/docs/",
  "bugs": {
    "url": "https://github.com/ptmafia/uncage/issues"
  }
}
