{
  "name": "@uncage/client",
  "version": "0.1.0",
  "description": "Browser transport for Uncage: REST calls and resumable SSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uncage/protocol": "workspace:^"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "client",
    "sse"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang"
}
