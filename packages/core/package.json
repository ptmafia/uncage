{
  "name": "@uncage/core",
  "version": "0.2.0",
  "description": "Uncage core: persistence and orchestration",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@uncage/protocol": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@uncage/testkit": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptmafia/uncage.git",
    "directory": "packages/core"
  },
  "keywords": [
    "uncage",
    "agent",
    "ai-agent",
    "sdk",
    "orchestration"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Nathan Zhang",
  "homepage": "https://ptmafia.github.io/uncage/",
  "bugs": {
    "url": "https://github.com/ptmafia/uncage/issues"
  }
