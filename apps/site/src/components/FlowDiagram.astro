---
/**
 * The hero illustration: a chat on your site, the WebSocket the user's machine dialed out, and Claude
 * Code running on that machine. Static HTML/CSS; the steps appear in order (CSS only), and appear at
 * once under prefers-reduced-motion.
 */
import { getDict, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).flow;
---

<figure class="flow">
  <figcaption class="visually-hidden">{t.label}</figcaption>
  <div class="win">
    <div class="chrome">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="url">{t.browserTitle}</span>
      <span class="online"><span class="led" aria-hidden="true"></span>{t.online}</span>
    </div>
    <div class="chat">
      <p class="bubble me r" style="--d: 0.15s">{t.userMessage}</p>
      <p class="bubble r" style="--d: 2.3s">{t.assistant}</p>
      <div class="tool r" style="--d: 2.6s">
        <div class="tool-head">
          <code translate="no">publish_page</code>
          <span class="tool-note">{t.toolNote}</span>
        </div>
        <div class="approve">
          <span class="y">{t.allow}</span>
          <span class="n">{t.deny}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="wire r" style="--d: 0.55s">
    <i class="line" aria-hidden="true"></i>
    <span>{t.wire}</span>
    <i class="line" aria-hidden="true"></i>
  </div>

  <div class="term">
    <p class="r" style="--d: 0.9s"><span class="d" translate="no">~/Uncage/your.site/s-42 ·</span> <span class="a" translate="no">claude</span></p>
    <p class="r" style="--d: 1.3s"><span class="g">✓</span> {t.termSkill} <span class="a" translate="no">landing-page</span></p>
    <p class="r" style="--d: 1.7s"><span class="g">✓</span> {t.termWrite} <span class="w" translate="no">landing/index.html</span></p>
    <p class="r" style="--d: 2.1s">
      <span class="a">→</span> <span translate="no">publish_page</span> · <span class="d">{t.termWaiting}</span><span class="caret" aria-hidden="true"></span>
    </p>
  </div>
</figure>

<style>
  .flow {
    position: relative;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--uc-line);
    border-radius: 22px;
    padding: clamp(14px, 2vw, 22px);
    box-shadow: var(--shadow-lg);
    min-width: 0;
  }
  .flow::before {
    /* soft accent glow behind the card */
    content: '';
    position: absolute;
    inset: 12% -6% -8% 10%;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--uc-accent) 22%, transparent), transparent);
    filter: blur(30px);
  }
  .win {
    border: 1px solid var(--uc-line);
    border-radius: 14px;
    background: var(--uc-paper);
    overflow: hidden;
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--uc-line);
    background: color-mix(in srgb, var(--uc-paper-2) 70%, var(--uc-paper));
    font-size: 12px;
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--uc-line);
  }
  .url {
    flex: 1;
    min-width: 0;
    max-width: 220px;
    margin: 0 auto;
    padding: 2px 10px;
    border-radius: 6px;
    background: var(--uc-paper);
    border: 1px solid var(--uc-line);
    color: var(--uc-ink-2);
    text-align: center;
    font-family: var(--uc-font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .online {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--uc-ink-2);
    white-space: nowrap;
  }
  .led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3f9b52;
    box-shadow: 0 0 0 3px rgb(63 155 82 / 0.18);
  }
  .chat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 14px;
  }
  .bubble {
    margin: 0;
    max-width: 86%;
    background: var(--surface);
    border: 1px solid var(--uc-line);
    border-radius: 14px 14px 14px 4px;
    padding: 9px 13px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--uc-ink);
  }
  .bubble.me {
    align-self: flex-end;
    background: var(--uc-ink);
    color: var(--uc-paper);
    border-color: var(--uc-ink);
    border-radius: 14px 14px 4px 14px;
  }
  .tool {
    background: var(--surface);
    border: 1px dashed color-mix(in srgb, var(--uc-accent) 70%, transparent);
    border-radius: 12px;
    padding: 10px 12px;
  }
  .tool-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-bottom: 10px;
  }
  .tool-head code {
    font-size: 13px;
    font-weight: 600;
    color: var(--uc-ink);
  }
  .tool-note {
    font-size: 12.5px;
    color: var(--uc-ink-2);
  }
  .tool-note::before {
    content: '→ ';
    color: var(--uc-accent-ink);
  }
  .approve {
    display: flex;
    gap: 8px;
  }
  .approve span {
    font-size: 13px;
    font-weight: 600;
    border-radius: 999px;
    padding: 5px 14px;
    border: 1px solid var(--uc-line);
    background: var(--uc-paper);
    color: var(--uc-ink);
  }
  .approve .y {
    background: var(--uc-accent-ink);
    border-color: var(--uc-accent-ink);
    color: #fff;
    animation: pulse 2.4s ease-in-out 3.4s 3;
  }
  :global([data-theme='dark']) .approve .y {
    color: #1d1b18;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .approve .y {
      color: #1d1b18;
    }
  }
  .wire {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 14px 4px;
    font-size: 12.5px;
    color: var(--uc-ink-2);
    text-align: center;
  }
  .wire .line {
    flex: 1;
    min-width: 16px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--uc-accent) 0 6px, transparent 6px 12px);
    background-size: 24px 2px;
    animation: flow 1.2s linear infinite;
    opacity: 0.85;
  }
  .wire .line:first-child {
    animation-direction: reverse;
  }
  .term {
    background: var(--uc-code);
    color: var(--term-fg);
    border-radius: 14px;
    padding: 14px 16px;
    font-family: var(--uc-font-mono);
    font-size: 12.5px;
    line-height: 1.8;
    overflow: hidden;
  }
  .term p {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .term .d {
    color: var(--term-dim);
  }
  .term .a {
    color: var(--term-accent);
  }
  .term .g {
    color: var(--term-ok);
  }
  .term .w {
    color: #fff;
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    margin-left: 4px;
    vertical-align: -2px;
    background: var(--term-accent);
    animation: blink 1.1s steps(1) infinite;
  }

  /* Entrance: each step rises in, in order (delay from --d). */
  .r {
    animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }
  .wire.r {
    animation-name: fade;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes flow {
    to {
      background-position: 24px 0;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--uc-accent) 40%, transparent);
    }
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--uc-accent) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .wire .line,
    .caret,
    .approve .y {
      animation: none;
    }
  }
  @media (max-width: 420px) {
    .online {
      font-size: 0;
      gap: 0;
    }
    .term {
      font-size: 11.5px;
      padding: 12px;
    }
  }
</style>
