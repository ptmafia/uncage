---
import { getDict, type Locale } from '../i18n/index.ts';
import { INSTALL_COMMANDS } from '../lib/install.ts';

interface Props {
  locale: Locale;
}

const t = getDict(Astro.props.locale).how;
/** Step 1 shows the visitor's installer (the line for the other OS is hidden by global.css; the hero tabs switch both). */
const codes: { line: string; os?: string }[][] = [
  INSTALL_COMMANDS.map((c) => ({ line: c.cmd, os: c.os })),
  [{ line: '<AgentChat />' }],
  [{ line: 'defineTool({ name, input, handler })' }],
];
---

<section class="section" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <p class="kicker">{t.kicker}</p>
    <h2 class="h2" id="how-title">{t.title}</h2>
    <p class="sub">{t.sub}</p>
    <ol class="steps" role="list">
      {
        t.steps.map((s, i) => (
          <li class="step">
            <p class="n">
              <span>{String(i + 1).padStart(2, '0')}</span>
              {s.tag}
            </p>
            <h3>{s.title}</h3>
            <p class="body">{s.body}</p>
            <code translate="no">
              {codes[i]!.map((c) => (
                <span class="line" data-os-only={c.os}>
                  {c.line}
                </span>
              ))}
            </code>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--uc-line);
    box-shadow: var(--shadow-sm);
  }
  .step:not(:last-child)::after {
    /* connector to the next step */
    content: '';
    position: absolute;
    top: 38px;
    right: -21px;
    width: 21px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--uc-accent) 0 4px, transparent 4px 8px);
  }
  .n {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--uc-accent-ink);
  }
  .n span {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--uc-accent-soft);
    font-family: var(--uc-font-mono);
    letter-spacing: 0;
  }
  h3 {
    margin: 16px 0 8px;
    font-size: 19px;
    font-weight: 680;
    line-height: 1.3;
  }
  .body {
    margin: 0 0 20px;
    font-size: 15px;
    color: var(--uc-ink-2);
    flex: 1;
  }
  code {
    display: block;
    font-size: 13px;
    background: var(--uc-paper);
    border: 1px solid var(--uc-line);
    border-radius: 10px;
    padding: 10px 12px;
    color: var(--uc-ink);
    overflow-x: auto;
    white-space: nowrap;
  }
  .line {
    display: block;
  }
  /* The install command wraps instead of scrolling, so the whole of it stays visible. */
  .line[data-os-only] {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .step:not(:last-child)::after {
      top: auto;
      bottom: -21px;
      right: auto;
      left: 40px;
      width: 2px;
      height: 21px;
      background: repeating-linear-gradient(180deg, var(--uc-accent) 0 4px, transparent 4px 8px);
    }
  }
</style>
