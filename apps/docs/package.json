{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Uncage help site (Astro Starlight) for developers and coding agents",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node scripts/check-snippets.ts && astro build",
    "check:snippets": "node scripts/check-snippets.ts",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "astro-mermaid": "^2.2.0",
    "mermaid": "^12.3.0",
    "starlight-links-validator": "^0.27.0",
    "starlight-typedoc": "^0.23.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uncage/client": "workspace:*",
    "@uncage/core": "workspace:*",
    "@uncage/hub": "workspace:*",
    "@uncage/protocol": "workspace:*",
    "@uncage/react": "workspace:*",
    "@uncage/react-ui": "workspace:*",
    "@uncage/server": "workspace:*",
    "@uncage/agent": "workspace:*",
    "@uncage/runtime-claude": "workspace:*",
    "@uncage/runtime-codex": "workspace:*",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "hono": "^4.13.17",
    "ioredis": "^5.11.1",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  }
}
