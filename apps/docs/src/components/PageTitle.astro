---
/**
 * Starlight's page title plus a "Markdown" link to the plain-markdown version of the page
 * (`/<page>.md`), for copying into a coding agent.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { mdPathOf } from '../lib/markdown';

const { entry, lang } = Astro.locals.starlightRoute;
const slug = entry.id.replace(/(^|\/)index$/, '');
const href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${mdPathOf(slug)}`;
const locale = lang?.toLowerCase().startsWith('zh') ? 'zh' : lang?.toLowerCase().startsWith('ja') ? 'ja' : 'en';
const label = { en: 'View as Markdown', zh: '本页 Markdown', ja: 'Markdownで表示' }[locale];
const hint = {
  en: 'Plain markdown of this page, for coding agents',
  zh: '纯 Markdown 版本，适合交给 coding agent',
  ja: 'このページのプレーンなMarkdown（コーディングエージェント向け）',
}[locale];
---

<div class="uc-title">
  <Default />
  <a class="uc-md-link" href={href} title={hint}>{label}</a>
</div>
