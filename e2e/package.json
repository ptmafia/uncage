{
  "name": "@uncage/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the Uncage example apps",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "e2e:mock": "playwright test --project=mock-default --project=mock-headless --project=connected-mock --project=connected-multinode --project=connected-faas-mock",
    "e2e:live": "playwright test --project=live-claude --project=connected-live --project=connected-acp-live --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.101.0",
    "@playwright/test": "^1.65.0",
    "@uncage/agent": "workspace:*",
    "@uncage/cli": "workspace:*",
    "@uncage/core": "workspace:*",
    "@uncage/protocol": "workspace:*",
    "@uncage/server": "workspace:*",
    "@uncage/testkit": "workspace:*",
    "connected-demo": "workspace:*",
    "nextjs-default-chat": "workspace:*",
    "react-headless-chat": "workspace:*"
  }
}
