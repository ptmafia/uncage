{
  "manifest_version": 3,
  "name": "Uncage Connected Extension",
  "version": "0.0.0",
  "description": "Side panel that drives your local coding agent through an Uncage hub",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "__HUB_ORIGIN__/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Uncage"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
