{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_HUB_URL": "https://demo.example.com",
        "ANDROID_PACKAGE": "dev.uncage.connectedexpo",
        "EAS_PROJECT_ID": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HUB_URL": "https://demo.example.com",
        "ANDROID_PACKAGE": "dev.uncage.connectedexpo",
        "EAS_PROJECT_ID": ""
      }
    }
  }
}
