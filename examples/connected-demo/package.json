{
  "name": "connected-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Uncage reference site for Connected Mode: the website commands the user's own Claude Code, Claude Code calls the site's tools, the process and the assets stay on the website",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node server.ts",
    "dev:faas": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.ts",
    "start:faas": "next start",
    "multinode": "NODE_ENV=production node scripts/multinode.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uncage/hub": "workspace:*",
    "@uncage/protocol": "workspace:*",
    "@uncage/react": "workspace:*",
    "@uncage/react-ui": "workspace:*",
    "ioredis": "^5.11.1",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
